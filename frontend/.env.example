# Festival Simulator Frontend Environment Variables

# Backend API Server URL
VITE_SERVER_URL=http://localhost:8080

# WebSocket URL (usually same as server URL)
VITE_WEBSOCKET_URL=http://localhost:8080

# API Base Path
VITE_API_BASE_URL=/api/v1

# Development settings
VITE_DEV_MODE=true
VITE_LOG_LEVEL=debug

# Admin settings
VITE_ADMIN_TOKEN=admin-secret-token

# Feature flags
VITE_ENABLE_DEBUG_TOOLS=true
VITE_ENABLE_ADMIN_PANEL=true
VITE_ENABLE_MAP_EDITOR=true

# Analytics (optional)
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# PWA settings
VITE_APP_NAME="Festival Simulator"
VITE_APP_DESCRIPTION="Real-time festival management and simulation platform"
VITE_APP_THEME_COLOR="#8b5cf6"